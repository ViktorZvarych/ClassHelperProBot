```sql
CREATE TABLE duty_log (
    id              SERIAL PRIMARY KEY,
    duty_date       DATE NOT NULL,
    student_id      INT NOT NULL REFERENCES students(id) ON DELETE CASCADE,
    status          TEXT NOT NULL
                        CHECK (status IN ('pending', 'completed', 'replaced', 'absent')),
    replaced_by_id  INT NULL REFERENCES students(id) ON DELETE SET NULL,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    UNIQUE(duty_date, student_id),
    -- Якщо replaced: replaced_by_id обов'язковий і не може збігатися з student_id
    CONSTRAINT duty_log_replaced_check CHECK (
        (status = 'replaced' AND replaced_by_id IS NOT NULL AND replaced_by_id != student_id)
        OR
        (status != 'replaced' AND replaced_by_id IS NULL)
    ),
    -- completed не може мати replaced_by_id (замінений — окремий запис)
    CONSTRAINT duty_log_completed_check CHECK (
        status != 'completed' OR replaced_by_id IS NULL
    )
);

CREATE INDEX idx_duty_log_duty_date ON duty_log(duty_date);
CREATE INDEX idx_duty_log_student_id ON duty_log(student_id);
CREATE INDEX idx_duty_log_replaced_by_id
    ON duty_log(replaced_by_id)
    WHERE replaced_by_id IS NOT NULL;
```

**Семантика статусів:**
- `pending` — призначений черговий, чергування ще не підтверджено.
- `completed` — чергування підтверджено, відбулося.
- `replaced` — цей учень був відсутній і пропустив чергування; замість нього чергував інший (`replaced_by_id` = ID замінюючого).
- `absent` — учень був відсутній, пропустив чергування, але жодного замінюючого не записано для нього (або заміна записана окремим `pending`-рядком).

