    (date(2025, 1, 15), date(2025, 1, 13), 'numerator', 'numerator'),
    (date(2025, 1, 16), date(2025, 1, 13), 'numerator', 'numerator'),
    # Дата до semester_start (від'ємний тиждень)
    (date(2025, 1, 6), date(2025, 1, 13), 'numerator', 'denominator'),
