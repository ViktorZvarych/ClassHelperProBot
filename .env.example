# Telegram
BOT_TOKEN=                        # Токен бота від @BotFather
WEBHOOK_SECRET=                   # Довільний рядок для підпису webhook (мін. 32 символи)

# База даних
DATABASE_URL=postgresql://user:pass@host:5432/db

# Redis
REDIS_URL=redis://localhost:6379/0

# Хостинг
RENDER_EXTERNAL_URL=              # Наприклад: https://myclassbot.onrender.com

# Безпека
CRON_SECRET_TOKEN=                # Токен для захисту /cron/* ендпоінтів (мін. 32 символи)
GROUP_CHAT_ID=                    # ID групового чату класу (від'ємне число)
SUPER_ADMIN_IDS=123456789,987654321  # Telegram ID супер-адмінів через кому

# Час
TIMEZONE=Europe/Kyiv

# Моніторинг (опціонально — якщо порожньо, Sentry не підключається)
SENTRY_DSN=